# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# Editors and local workspace state
.idea/
*.code-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Cursor rules and skills under .cursor/ are intentionally versioned.
# Ignore only explicitly local Cursor files.
.cursor/*.local.*

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
secrets*.yaml
secrets*.yml

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

# Python environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheelhouse/
*.spec
*.pyz
*.pyw
!scripts/*.pyw

# Release launcher artifacts generated into repo root
RELEASE.txt
CustomItemForge.sh

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results/

# Notebooks
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
~$*

# Local databases
*.sqlite
*.sqlite3
*.db

# Real calibration samples (user-provided binaries stay ignored)
tests/fixtures/real/**
!tests/fixtures/real/**/
!tests/fixtures/real/README.md
!tests/fixtures/real/**/NOTES.md
!tests/fixtures/real/**/README.md
!tests/fixtures/real/**/BASELINE_MATRIX.md
!tests/fixtures/real/**/BASELINE_MATRIX.json
